PORT=4300
# Must include the database name, or Mongoose silently uses "test"
MONGODB_URI=mongodb://127.0.0.1:27017/avico
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/avico?retryWrites=true&w=majority

# Change this. Any long random string.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES=7d

# Seeded on the first `npm run seed` only; change the password from Settings afterwards
ADMIN_EMAIL=admin@avico.example
ADMIN_PASSWORD=changeme

# Comma separated. Supports wildcards, e.g. https://*.vercel.app
CORS_ORIGINS=http://localhost:5190,http://localhost:5180
PUBLIC_URL=http://localhost:4300
